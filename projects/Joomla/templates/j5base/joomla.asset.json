{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "j5base",
  "version": "1.0.0",
  "description": "Template base per siti semplici.",
  "license": "GPL-2.0-or-later",
  "assets": [
    {
      "name": "bootstrap-css",
      "type": "style",
      "uri": "bootstrap/bootstrap.css"
    },
    {
      "name": "bootstrap-ico",
      "type": "style",
      "uri": "bootstrap/icone/font/bootstrap-icons.css"
    },
    {
      "name": "bootstrap-js",
      "type": "script",
      "uri": "bootstrap/bootstrap.bundle.js",
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "leaflet-css",
      "type": "style",
      "uri": "leaflet/leaflet.css"
    },
    {
      "name": "leaflet-marker-css",
      "type": "style",
      "uri": "leaflet/MarkerCluster.css"
    },
    {
      "name": "leaflet-marker-default-css",
      "type": "style",
      "uri": "leaflet/MarkerCluster.Default.css"
    },
    {
      "name": "leaflet-js",
      "type": "script",
      "uri": "leaflet/leaflet.js"
    },
    {
      "name": "leaflet-marker-js",
      "type": "script",
      "uri": "leaflet/leaflet.markercluster.js",
      "dependencies": [
        "leaflet-js"
      ],
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "alpine-js",
      "type": "script",
      "uri": "alpine.js",
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "jquery",
      "type": "script",
      "uri": "jquery.js",
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "searchtools",
      "type": "style",
      "uri": "system/searchtools/searchtools.min.css"
    },
    {
      "name": "fontawesome",
      "type": "style",
      "uri": "system/joomla-fontawesome.min.css"
    },
    {
      "name": "user-css",
      "type": "style",
      "uri": "user.css"
    },
    {
      "name": "user-js",
      "type": "script",
      "uri": "user.js"
    },
    {
      "name": "core",
      "type": "preset",
      "description": "Tutti gli asset del Core",
      "dependencies": [
        "searchtools#style",
        "fontawesome#style",
        "jquery#script"
      ]
    },
    {
      "name": "bootstrap",
      "type": "preset",
      "description": "Tutti gli asset di Bootstrap",
      "dependencies": [
        "bootstrap-css#style",
        "bootstrap-ico#style",
        "bootstrap-js#script"
      ]
    },
    {
      "name": "leaflet",
      "type": "preset",
      "description": "Tutti gli asset di Leaflet",
      "dependencies": [
        "leaflet-css#style",
        "leaflet-marker-css#style",
        "leaflet-marker-default-css#style",
        "leaflet-js#script",
        "leaflet-marker-js#script"
      ]
    },
    {
      "name": "user",
      "type": "preset",
      "description": "Tutti gli asset dell'Utente",
      "dependencies": [
        "user-css#style",
        "user-js#script"
      ]
    }
  ]
}