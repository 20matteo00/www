<?xml version="1.0" encoding="utf-8"?>
<extension type="template" client="site" method="upgrade">
	<name>J5BASE</name>
	<version>1.0</version>
	<creationDate>2025</creationDate>
	<author>Moscone</author>
	<authorEmail>m.moscone@liguriadigitale.it</authorEmail>
	<description>Template base</description>
	<inheritable>1</inheritable>
	<files>
		<filename>index.php</filename>
		<filename>joomla.asset.json</filename>
		<filename>templateDetails.xml</filename>
		<folder>html</folder>
		<folder>forms</folder>
	</files>
	<media destination="templates/site/j5base" folder="media">
		<folder>js</folder>
		<folder>css</folder>
		<folder>fonts</folder>
		<folder>images</folder>
	</media>
	<positions>
		<!-- Header -->
		<position>header-top</position>
		<position>header-content</position>
		<position>header-bottom</position>
		<position>breadcrumb</position>

		<!-- Extra / Mobile -->
		<position>offcanvas</position>		<!-- Menu o moduli nascosti su mobile -->
		<position>sticky</position>		<!-- Banner o CTA sticky sopra contenuto -->

		<!-- Content principale -->
		<position>content-top</position>
		<position>sidebar-left</position>
		<position>content-top-in-sidebar</position>
		<position>content-bottom-in-sidebar</position>
		<position>sidebar-right</position>
		<position>content-bottom</position>

		<!-- Footer -->
		<position>footer-top</position>
		<position>footer-content</position>
		<position>footer-bottom</position>
	</positions>
	<config>
		<fields name="params">
			<fieldset name="advanced">
				<!-- campo favicon -->
				<field name="favicon" type="media" label="Favicon" directory="images" description="Favicon del sito" default="media/templates/site/j5base/images/favicon.png"/>
				<!-- campo logo -->
				<field name="logo" type="media" label="Logo" directory="images" description="Logo del sito" default="media/templates/site/j5base/images/logoRL.png"/>
				<!-- campo colori -->
				<field name="colors" type="subform" label="Colori tema" description="Aggiungi uno o più colori" formsource="templates/j5base/forms/colors.xml" multiple="true"/>
				<!-- campi mobile menu -->
				<field name="mobile_menu" type="radio" label="Menu Mobile" description="Seleziona come deve comportarsi il menu mobile" default="collapse">
					<option value="collapse">Collapse (classico)</option>
					<option value="offcanvas">Offcanvas (laterale)</option>
				</field>
				<field name="lato_menu" type="radio" label="Lato Menu Mobile" description="Seleziona da che lato vuoi vedere il menu" default="left" showon="mobile_menu:offcanvas">
					<option value="start">Sinistra</option>
					<option value="end">Destra</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
